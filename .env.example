# Google Maps API (Street View + Satellite + Geocoding)
GOOGLE_MAPS_API_KEY=

# Mapbox (map display + geocoding)
MAPBOX_API_KEY=

# OpenAI (Vision analysis)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_SEGMENTED_REASONING_MODEL=

# Postgres
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
DATABASE_URL=postgresql://argus:argus@localhost:5432/argus

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=argus

# SAM 3.1 segmentation service
SAM_SERVICE_URL=
SAM_MODEL_ID=facebook/sam3.1
HF_TOKEN=

# Langfuse (AI tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
